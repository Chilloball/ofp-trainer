{
  "name": "ofp-trainer",
  "version": "1.0.0",
  "private": true,
  "description": "Adaptive Lernplattform für die Klausur 'Objektorientierte und Funktionale Programmierung' (Uni Siegen)",
  "scripts": {
    "predev": "node scripts/build-content.mjs",
    "dev": "next dev",
    "prebuild": "node scripts/build-content.mjs",
    "build": "next build",
    "start": "npx --yes serve@latest out -l 3000",
    "content": "node scripts/build-content.mjs",
    "typecheck": "tsc --noEmit",
    "test:java": "sucrase-node scripts/java-tests.ts",
    "test:java:jdk": "sucrase-node scripts/java-compare.ts",
    "verify:java": "sucrase-node scripts/verify-solutions.ts",
    "check": "npm run content && npm run typecheck && npm run test:java && npm run verify:java"
  },
  "dependencies": {
    "@codemirror/lang-java": "^6.0.1",
    "@codemirror/lang-python": "^6.1.6",
    "@codemirror/theme-one-dark": "^6.1.2",
    "@uiw/react-codemirror": "^4.23.7",
    "framer-motion": "^11.15.0",
    "lucide-react": "^0.468.0",
    "mermaid": "^11.4.1",
    "next": "^15.1.6",
    "prism-react-renderer": "^2.4.1",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "react-markdown": "^9.0.3",
    "remark-gfm": "^4.0.0",
    "zod": "^3.24.1",
    "@codemirror/language": "^6.10.8",
    "@lezer/highlight": "^1.2.1"
  },
  "devDependencies": {
    "@types/node": "^22.10.5",
    "@types/react": "^19.0.7",
    "@types/react-dom": "^19.0.3",
    "autoprefixer": "^10.4.20",
    "postcss": "^8.4.49",
    "tailwindcss": "^3.4.17",
    "typescript": "^5.7.3",
    "sucrase": "^3.35.0"
  },
  "engines": {
    "node": ">=20"
  }
}